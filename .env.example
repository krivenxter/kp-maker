# Порт опционального PDF-сервиса.
PDF_SERVER_PORT=4174

# Публичный URL отдельного PDF-сервиса для production. Оставьте пустым для
# локальной разработки: тогда Vite использует proxy на localhost:4174.
VITE_PDF_API_URL=

# Origin frontend-приложения, которому разрешены CORS-запросы.
# Для локальной разработки можно оставить *.
PDF_CORS_ORIGIN=*

# Порт интерфейса в режиме разработки.
VITE_DEV_PORT=5173

# Путь к LibreOffice, если бинарник не доступен через PATH.
LIBREOFFICE_BIN=soffice
